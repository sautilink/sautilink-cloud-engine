/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-OWPK02FasJRkiTH2Tfx80vGxVJZJNawAll7qdxItaFA=' 'sha256-pc6013YHB1MIzWlcU1QiFMx+Mjzxjl5gRQsfIF6MMpQ='; style-src 'self'; img-src 'self' data: https://sautilink.com; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/api/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

/assets/brand/typography-manrope.css
  Cache-Control: public, max-age=0, must-revalidate

/assets/brand/product-shell.css
  Cache-Control: public, max-age=0, must-revalidate

/assets/brand/cloud-engine-share.png
  Cache-Control: public, max-age=86400

/assets/brand/launch-splash.css
  Cache-Control: public, max-age=86400

/assets/brand/launch-splash.js
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: no-cache

/.well-known/assetlinks.json
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *

/favicon/*
  Cache-Control: public, max-age=86400

/assets/fonts/manrope/*
  Cache-Control: public, max-age=31536000, immutable
